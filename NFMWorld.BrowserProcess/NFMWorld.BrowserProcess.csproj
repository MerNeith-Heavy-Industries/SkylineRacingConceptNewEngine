<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NFMWorld.BrowserProcess</AssemblyName>
    <RootNamespace>NFMWorld.BrowserProcess</RootNamespace>
    <RuntimeIdentifiers>osx-x64;osx-arm64;win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <RunPostBuildEvent>OnOutputUpdated</RunPostBuildEvent>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PublishCommonConfig>Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework);IsPublishing=True;PublishTrimmed=True;SelfContained=True;RuntimeIdentifier=</PublishCommonConfig>
    <IsEditbinEnabled>True</IsEditbinEnabled>
    <CETCompat>false</CETCompat>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="ObjectBinding\CefGlueGlobalScript.js" />
  </ItemGroup>

  <PropertyGroup>
    <UseCefGlueArm64Package Condition="'$(RuntimeIdentifier)' != ''">$([System.String]::Copy('$(RuntimeIdentifier)').EndsWith('-arm64'))</UseCefGlueArm64Package>
    <UseCefGlueArm64Package Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">true</UseCefGlueArm64Package>
    <UseCefGlueArm64Package Condition="'$(UseCefGlueArm64Package)' == '' and '$(RuntimeIdentifier)' == '' and '$(Platform)' != 'x64'">$([System.String]::Copy('$(NETCoreSdkRuntimeIdentifier)').EndsWith('-arm64'))</UseCefGlueArm64Package>
  </PropertyGroup>

  <!--
    Prevent CefGlue.Common NuGet from copying its bundled self-contained browser process
    (Xilium.CefGlue.BrowserProcess.exe + entire .NET runtime) to output/publish.
    NFMWorld.BrowserProcess.exe already compiles all CefGlue.BrowserProcess source via ProjectReference.
  -->
  <ItemGroup>
    <CefGlueBrowserProcessFiles Remove="@(CefGlueBrowserProcessFiles)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CefGlue\CefGlue.BrowserProcess\CefGlue.BrowserProcess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RawCef.Binaries.Windows64.Release" Version="151.3.14-ci.20260801023219" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="RawCef.Binaries.Macosarm64.Release" Version="151.3.14-ci.20260801023225" Condition="$([MSBuild]::IsOSPlatform('macOS'))" />
    <PackageReference Include="RawCef.Binaries.Linux64.Release" Version="151.3.14-ci.20260801023209" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

