<FlexPanel
    xmlns="https://github.com/uwx/worldxaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:w="https://github.com/needforrewrite/nfm-world"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance w:HudViewModel}"
    x:Class="NFMWorld.UI.Hud.PowerDamageBars"
    Top="0"
    Right="0"
    Padding="10"
    FlexDirection="Column"
    Gap="10"
    AlignItems="FlexEnd">

    <w:MeasureBar
        Name="DamageBar"
        FillAmount="{Binding DamageFillAmount}"
        ImageData="{w:StaticImage data/images/damage.gif}"
        Color="{Binding DamageColor}"
        Scale="1.2" />

    <w:MeasureBar
        Name="PowerBar"
        FillAmount="{Binding PowerFillAmount}"
        ImageData="{w:StaticImage data/images/power.gif}"
        Color="{Binding PowerColor}"
        Scale="1.2" />
</FlexPanel>