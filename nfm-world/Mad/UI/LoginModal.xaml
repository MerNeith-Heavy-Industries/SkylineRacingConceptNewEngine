<w:Modal
    xmlns="https://github.com/uwx/worldxaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:w="https://github.com/needforrewrite/nfm-world"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance w:LoginModalViewModel}"
    x:Class="NFMWorld.UI.Menu.LoginModal"
    DataType="w:LoginModalViewModel"
    Name="Root">

    <!-- Modal backdrop overlay -->
    <w:SolidBox
        Name="Backdrop"
        BackgroundColor="0,0,0,180"
        BorderColor="0,0,0,0"
        Position="Absolute"
        Top="0" Left="0" Right="0" Bottom="0" />

    <!-- Card container -->
    <FlexPanel
        Name="Card"
        FlexDirection="Column"
        MinWidth="380"
        Padding="24"
        Gap="16">

        <!-- Card background -->
        <w:SolidBox
            Name="CardBg"
            BackgroundColor="20,15,35,255"
            BorderColor="255,140,0,255"
            Border="2"
            BorderTopLeftRadius="8"
            BorderTopRightRadius="8"
            BorderBottomLeftRadius="8"
            BorderBottomRightRadius="8"
            Position="Absolute"
            Top="0" Left="0" Right="0" Bottom="0" />

        <!-- Tab bar -->
        <FlexPanel
            Name="TabBar"
            FlexDirection="Row"
            Gap="0"
            MarginBottom="8">

            <!-- Sign In tab -->
            <FlexPanel
                Name="SignInTab"
                Flex="1"
                Padding="12,10"
                AlignItems="Center"
                JustifyContent="Center"
                MousePressed="{Binding SwitchToSignInCommand}">
                <w:SolidBox
                    Name="SignInTabBg"
                    BackgroundColor="{Binding SignInTabBg}"
                    BorderColor="255,140,0,255"
                    Position="Absolute"
                    Top="0" Left="0" Right="0" Bottom="0"
                    BorderTopLeftRadius="6"
                    BorderTopRightRadius="6" />
                <w:TextRun
                    Name="SignInTabText"
                    Font="bold 18px Adventure"
                    Color="{Binding SignInTabColor}"
                    StrokeColor="black"
                    Text="SIGN IN" />
            </FlexPanel>

            <!-- Sign Up tab -->
            <FlexPanel
                Name="SignUpTab"
                Flex="1"
                Padding="12,10"
                AlignItems="Center"
                JustifyContent="Center"
                MousePressed="{Binding SwitchToSignUpCommand}">
                <w:SolidBox
                    Name="SignUpTabBg"
                    BackgroundColor="{Binding SignUpTabBg}"
                    BorderColor="255,140,0,255"
                    Position="Absolute"
                    Top="0" Left="0" Right="0" Bottom="0"
                    BorderTopLeftRadius="6"
                    BorderTopRightRadius="6" />
                <w:TextRun
                    Name="SignUpTabText"
                    Font="bold 18px Adventure"
                    Color="{Binding SignUpTabColor}"
                    StrokeColor="black"
                    Text="SIGN UP" />
            </FlexPanel>
        </FlexPanel>

        <!-- ── Sign In form ────────────────────────────────────── -->
        <FlexPanel
            Name="SignInForm"
            FlexDirection="Column"
            Gap="12"
            Display="{Binding SignInVisible, Converter={BoolToDisplayConverter}}">

            <w:TextInput
                Name="SignInUsernameInput"
                Placeholder="Username"
                Text="{Binding SignInUsername}"
                Font="18px DroidSans"
                Color="255,255,255,255"
                PlaceholderColor="128,128,128,255"
                BackgroundColor="30,25,50,255"
                BorderColor="255,140,0,255"
                CursorColor="255,140,0,255"
                SelectionColor="100,180,255,128"
                BorderTopLeftRadius="4"
                BorderTopRightRadius="4"
                BorderBottomLeftRadius="4"
                BorderBottomRightRadius="4"
                Padding="10,8"
                Submitted="{Binding SignInCommand}"/>

            <w:TextInput
                Name="SignInPasswordInput"
                Placeholder="Password"
                Text="{Binding SignInPassword}"
                Font="18px DroidSans"
                Color="255,255,255,255"
                PlaceholderColor="128,128,128,255"
                BackgroundColor="30,25,50,255"
                BorderColor="255,140,0,255"
                CursorColor="255,140,0,255"
                SelectionColor="100,180,255,128"
                BorderTopLeftRadius="4"
                BorderTopRightRadius="4"
                BorderBottomLeftRadius="4"
                BorderBottomRightRadius="4"
                Padding="10,8"
                Submitted="{Binding SignInCommand}"/>

            <!-- Sign In submit button -->
            <FlexPanel
                Name="SignInButton"
                AlignItems="Center"
                JustifyContent="Center"
                Padding="10,8"
                MarginTop="4"
                MousePressed="{Binding SignInCommand}">
                <w:SolidBox
                    Name="SignInBtnBg"
                    BackgroundColor="255,140,0,255"
                    BorderColor="255,140,0,255"
                    BorderTopLeftRadius="4"
                    BorderTopRightRadius="4"
                    BorderBottomLeftRadius="4"
                    BorderBottomRightRadius="4"
                    Position="Absolute"
                    Top="0" Left="0" Right="0" Bottom="0" />
                <w:TextRun
                    Name="SignInBtnText"
                    Font="bold 18px Adventure"
                    Color="20,15,35,255"
                    Text="SIGN IN" />
            </FlexPanel>
        </FlexPanel>

        <!-- ── Sign Up form ────────────────────────────────────── -->
        <FlexPanel
            Name="SignUpForm"
            FlexDirection="Column"
            Gap="12"
            Display="{Binding SignUpVisible, Converter={BoolToDisplayConverter}}">

            <w:TextInput
                Name="SignUpUsernameInput"
                Placeholder="Username"
                Text="{Binding SignUpUsername}"
                Font="18px DroidSans"
                Color="255,255,255,255"
                PlaceholderColor="128,128,128,255"
                BackgroundColor="30,25,50,255"
                BorderColor="255,140,0,255"
                CursorColor="255,140,0,255"
                SelectionColor="100,180,255,128"
                BorderTopLeftRadius="4"
                BorderTopRightRadius="4"
                BorderBottomLeftRadius="4"
                BorderBottomRightRadius="4"
                Padding="10,8" />

            <w:TextInput
                Name="SignUpEmailInput"
                Placeholder="Email"
                Text="{Binding SignUpEmail}"
                Font="18px DroidSans"
                Color="255,255,255,255"
                PlaceholderColor="128,128,128,255"
                BackgroundColor="30,25,50,255"
                BorderColor="255,140,0,255"
                CursorColor="255,140,0,255"
                SelectionColor="100,180,255,128"
                BorderTopLeftRadius="4"
                BorderTopRightRadius="4"
                BorderBottomLeftRadius="4"
                BorderBottomRightRadius="4"
                Padding="10,8" />

            <w:TextInput
                Name="SignUpPasswordInput"
                Placeholder="Password"
                Text="{Binding SignUpPassword}"
                Font="18px DroidSans"
                Color="255,255,255,255"
                PlaceholderColor="128,128,128,255"
                BackgroundColor="30,25,50,255"
                BorderColor="255,140,0,255"
                CursorColor="255,140,0,255"
                SelectionColor="100,180,255,128"
                BorderTopLeftRadius="4"
                BorderTopRightRadius="4"
                BorderBottomLeftRadius="4"
                BorderBottomRightRadius="4"
                Padding="10,8" />

            <!-- Sign Up submit button -->
            <FlexPanel
                Name="SignUpButton"
                AlignItems="Center"
                JustifyContent="Center"
                Padding="10,8"
                MarginTop="4"
                MousePressed="{Binding SignUpCommand}">
                <w:SolidBox
                    Name="SignUpBtnBg"
                    BackgroundColor="255,140,0,255"
                    BorderColor="255,140,0,255"
                    BorderTopLeftRadius="4"
                    BorderTopRightRadius="4"
                    BorderBottomLeftRadius="4"
                    BorderBottomRightRadius="4"
                    Position="Absolute"
                    Top="0" Left="0" Right="0" Bottom="0" />
                <w:TextRun
                    Name="SignUpBtnText"
                    Font="bold 18px Adventure"
                    Color="20,15,35,255"
                    Text="SIGN UP" />
            </FlexPanel>
        </FlexPanel>

        <!-- Error message -->
        <w:TextRun
            Name="ErrorMessage"
            Font="14px DroidSans"
            Color="255,80,80,255"
            Text="{Binding ErrorMessage}" />

        <!-- Discord button -->
        <FlexPanel
            Name="DiscordButton"
            FlexDirection="Row"
            AlignItems="Center"
            JustifyContent="Center"
            Padding="10,8"
            Gap="8"
            MousePressed="{Binding DiscordSignInCommand}">
            <w:SolidBox
                Name="DiscordBtnBg"
                BackgroundColor="88,101,242,255"
                BorderColor="88,101,242,255"
                BorderTopLeftRadius="4"
                BorderTopRightRadius="4"
                BorderBottomLeftRadius="4"
                BorderBottomRightRadius="4"
                Position="Absolute"
                Top="0" Left="0" Right="0" Bottom="0" />
            <w:TextRun
                Name="DiscordBtnText"
                Font="14px Adventure"
                Color="255,255,255,255"
                Text="SIGN IN WITH DISCORD" />
        </FlexPanel>

        <!-- Close link -->
        <FlexPanel
            Name="CloseLink"
            AlignItems="Center"
            JustifyContent="Center"
            Padding="4"
            MousePressed="{Binding CloseCommand}">
            <w:TextRun
                Name="CloseText"
                Font="14px Adventure"
                Color="160,160,160,255"
                Text="Cancel" />
        </FlexPanel>
    </FlexPanel>
</w:Modal>
