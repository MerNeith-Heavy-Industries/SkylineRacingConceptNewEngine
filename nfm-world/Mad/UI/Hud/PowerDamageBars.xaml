<yoga:FlexPanel
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:yoga="clr-namespace:WorldXaml.UI.Yoga;assembly=WorldXaml.UI.Yoga"
    xmlns:w="https://github.com/needforrewrite/nfm-world"
    x:Class="NFMWorld.UI.Hud.PowerDamageBars"
    Top="0"
    Padding="10"
    FlexDirection="Column"
    Gap="10"
    AlignItems="FlexEnd">

    <w:MeasureBar
        Name="DamageBar"
        FillAmount="0"
        ImageData="{w:StaticImage data/images/damage.gif}"
        Scale="1.2" />

    <w:MeasureBar
        Name="PowerBar"
        FillAmount="0.98"
        ImageData="{w:StaticImage data/images/power.gif}"
        Scale="1.2" />
</yoga:FlexPanel>