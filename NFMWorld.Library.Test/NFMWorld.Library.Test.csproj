<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
        <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
        <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NFMWorld.Library\NFMWorld.Library.csproj" />
        <ProjectReference Include="..\NFMWorld.ClientOnlyAnalyzer\NFMWorld.ClientOnlyAnalyzer.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    </ItemGroup>

    <!--
      NuLua.Luau's native luau.dll lands under runtimes/{rid}/native/, but DllImport("luau")
      needs it on the probing path. Copy the current RID's binary to the output root
      (mirrors NuLua.Tests's osx/linux handling).
    -->
    <Target Name="CopyLuauNativeToRoot" AfterTargets="Build">
        <ItemGroup>
            <_LuauNative Include="$(OutDir)runtimes\$(NETCoreSdkRuntimeIdentifier)\native\luau.dll"
                          Condition="'$(NETCoreSdkRuntimeIdentifier)' != '' and Exists('$(OutDir)runtimes\$(NETCoreSdkRuntimeIdentifier)\native\luau.dll')" />
        </ItemGroup>
        <Copy SourceFiles="@(_LuauNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    </Target>

</Project>
